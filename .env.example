# Lightweight local development models: no API keys; embeddings download ~90 MB once.
CHAT_MODEL=extractive:top-passage
EMBEDDING_MODEL=huggingface:sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RAG_DATABASE_URL=postgresql+psycopg://rag:rag@localhost:6024/rag
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_PROJECT=
# Required by bin/serve; generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=

# Optional: signed PDF citation links (see README).
NOTEBOOK_ASSETS_ROOT=
NOTEBOOK_ASSETS_BASE_URL=
NOTEBOOK_ASSETS_LINK_SECRET=

# Open WebUI.
VECTOR_DB=pgvector
PGVECTOR_DB_URL=postgresql+psycopg://rag:rag@127.0.0.1:6024/rag
OFFLINE_MODE=true
RAG_EMBEDDING_ENGINE=openai

# bin/serve: where it listens and where Open WebUI keeps its data. Keep the port
# in OPENAI_API_BASE_URL equal to PORT; Open WebUI calls the API over loopback.
HOST=127.0.0.1
PORT=8000
DATA_DIR=.open-webui
FRONTEND_BUILD_DIR=.open-webui/frontend
OPENAI_API_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEYS=not-needed

# Open WebUI initial defaults. Settings already saved in Open WebUI take precedence.
DEFAULT_MODELS=notebook-rag
ENABLE_OLLAMA_API=false
ENABLE_TITLE_GENERATION=false
ENABLE_TAGS_GENERATION=false
ENABLE_FOLLOW_UP_GENERATION=false
ENABLE_AUTOCOMPLETE_GENERATION=false
USER_PERMISSIONS_CHAT_CONTROLS=false
USER_PERMISSIONS_CHAT_WEB_UPLOAD=false
