#!/usr/bin/env python3
"""Run the API, citation assets and Open WebUI: ``uv run bin/serve``.

Does not run migrations or build the frontend; run ``bin/migrate`` and
``bin/frontend`` first. Settings come from ``.env`` (see ``.env.example``).
"""

import os
import sys

from dotenv import load_dotenv


def main() -> None:
    import uvicorn

    load_dotenv()
    missing = [
        name
        for name in (
            "WEBUI_SECRET_KEY",
            "NOTEBOOK_ASSETS_ROOT",
            "NOTEBOOK_ASSETS_BASE_URL",
            "NOTEBOOK_ASSETS_LINK_SECRET",
        )
        if not os.environ.get(name)
    ]
    if missing:
        sys.exit(
            f"Set {', '.join(missing)} in .env (see .env.example). "
            "Secrets: openssl rand -hex 32."
        )
    uvicorn.run(
        "notebook.app:create_app",
        factory=True,
        host=os.environ.get("HOST", "127.0.0.1"),
        port=int(os.environ.get("PORT", "8000")),
    )


if __name__ == "__main__":
    main()
